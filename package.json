{
  "name": "@coremedia/ckeditor5",
  "version": "1.0.0",
  "author": {
    "name": "CoreMedia GmbH",
    "email": "info@coremedia.com",
    "url": "https://coremedia.com/",
    "avatar": "data:image/svg+xml;base64,"
  },
  "engines": {
    "node": "^24.22.1",
    "pnpm": "^11.28.8"
  },
  "packageManager": "pnpm@11.28.8+sha512.f6988a32046b9a3f78d7d7ee0747926bbe905ff9dff73bf19abb87bd7d1906a2ac90d93f73be32b5f9e14c2899569bcb0c9c5ec8a19e083f5d71bbab6dd9e0b8",
  "private": true,
  "description": "Plugins required or recommended to use CKEditor 5 within CoreMedia Studio.",
  "keywords": [
    "ckeditor",
    "ckeditor5",
    "ckeditor 5",
    "wysiwyg",
    "rich text",
    "editor",
    "html",
    "contentEditable",
    "editing",
    "operational transformation",
    "coremedia",
    "coremedia cms",
    "coremedia studio"
  ],
  "repository": {
    "url": "https://github.com/CoreMedia/ckeditor-plugins",
    "type": "git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "set-version": "set-version",
    "changeset": "changeset",
    "ci:version": "changeset version && pnpm install --lockfile-only",
    "ci:publish": "changeset publish",
    "clean": "pnpm --recursive run clean",
    "clean:node_modules": "rimraf --glob \"./**/node_modules\"",
    "build": "pnpm --recursive build",
    "doc": "typedoc",
    "doc:config": "typedoc --showConfig",
    "ui-test": "pnpm --recursive --filter \"@coremedia/ckeditor5-playwright-itest\" run ui-test",
    "test": "pnpm --recursive test",
    "preinstall": "node ./scripts/check-pnpm.mjs",
    "start": "pnpm --recursive --filter \"@coremedia/ckeditor5-app\" start"
  },
  "dependencies": {
    "@coremedia/set-version": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@coremedia/studio-client.eslint-config": "catalog:",
    "eslint": "catalog:",
    "package-directory": "catalog:",
    "rimraf": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:"
  }
}
